# --- Bitrefill (gift cards) -------------------------------------------
# For testing: a personal API key from bitrefill.com > Account > Developers
BITREFILL_API_KEY=
# For launch: Business or Affiliate API credentials (apply at bitrefill.com/partner)
BITREFILL_API_ID=
BITREFILL_API_SECRET=
# Set to true while testing to include Bitrefill's test products
BITREFILL_TEST_PRODUCTS=false

# --- Jupiter (swaps any token into USDC) ------------------------------
# Free key from the Jupiter developer portal
JUPITER_API_KEY=
# Leave as-is unless Jupiter changes versions
JUPITER_API_BASE=https://api.jup.ag/swap/v1
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2

# --- Solana RPC (browser reads balances and sends the transaction) -----
# Use a private RPC (Helius, Triton, QuickNode). The public one is rate-limited.
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# --- Site --------------------------------------------------------------
# 32+ random characters. Protects gift card codes so only the buyer sees them.
GIFTED_SECRET=
# Contract address once $GIFTED is live on pump.fun
NEXT_PUBLIC_GIFTED_CA=
# Your live domain, e.g. https://gifted.xyz (used for share previews)
NEXT_PUBLIC_SITE_URL=
# Community links (leave blank to hide)
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# --- NEAR Intents (private checkout) -----------------------------------
# Same partner key as Parallax works. Without it swaps carry an extra network fee.
NEAR_INTENTS_JWT=
# public | basic | advanced (default advanced)
NEAR_CONFIDENTIALITY=advanced

# --- Live orders feed --------------------------------------------------
# Add Upstash Redis in Vercel → Storage; it fills these in automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
